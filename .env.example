# Mesmas credenciais do projeto Firebase do Didi Gás (ou um projeto novo, se preferir)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Nome da coleção de vendas no Firestore do Didi Gás (troque se não for "vendas")
VITE_SALES_COLLECTION=vendas

# Firebase de origem: somente leitura das vendas do Didi Gás
VITE_DIDI_GAS_API_KEY=
VITE_DIDI_GAS_AUTH_DOMAIN=
VITE_DIDI_GAS_PROJECT_ID=
VITE_DIDI_GAS_STORAGE_BUCKET=
VITE_DIDI_GAS_MESSAGING_SENDER_ID=
VITE_DIDI_GAS_APP_ID=

# --- Usadas só pela função /api/whatsapp.ts (servidor, não expostas ao navegador) ---
# Gere uma "service account key" em: Firebase Console > Configurações do projeto > Contas de serviço
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
